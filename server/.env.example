# Puerto del servidor API
PORT=5000

# Entorno de ejecución (development / production)
NODE_ENV=development

# Orígenes permitidos por CORS (separados por coma)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# API Key de BscScan (para verificación automática de contratos)
# Obtén una gratis en https://bscscan.com/myapikey
BSCSCAN_API_KEY=

# Proveedores RPC para BSC
BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.binance.org:8545/
BSC_MAINNET_RPC=https://bsc-dataseed.binance.org/

# ========================================================
# PERSISTENCIA CENTRAL: SUPABASE / POSTGRESQL (FASE 3)
# ========================================================
# URL del proyecto Supabase (ej: https://xyzcompany.supabase.co)
SUPABASE_URL=

# Service Role Key (clave privada del backend para escribir respetando RLS)
# Obténla en: Supabase Dashboard -> Project Settings -> API -> service_role key
SUPABASE_SERVICE_ROLE_KEY=

# Clave pública anónima de Supabase (opcional)
SUPABASE_ANON_KEY=

